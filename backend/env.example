# Copy to .env and fill in real values. Never commit .env.

PORT=8030
INGEST_API_KEY=change-me

# PC (through SSH tunnel):  mongodb://localhost:27018/call_summary
# Server:                   mongodb://admin:Admin%40123@127.0.0.1:27017/call_summary?authSource=admin
MONGODB_URI=

# PBX has an incomplete SSL chain -> skip certificate check for recording downloads only
RECORDING_TLS_VERIFY=false

BHASHINI_USER_ID=
BHASHINI_UDYAT_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# false = transcribe only, no OpenAI calls (use while there are no OpenAI credits)
SUMMARY_ENABLED=false
# false = skip the Hinglish version of the transcript (only used when SUMMARY_ENABLED=true)
HINGLISH_ENABLED=true

# Only these dispositions are transcribed / summarised (comma separated, case doesn't matter)
PROCESS_DISPOSITIONS=Explain DMP,Explained DMP

# Calls this short or shorter are skipped (seconds)
MIN_CALL_SECONDS=30

# Automatic processing window (India time). Leave both empty = manual only.
PROCESS_WINDOW_START=22:00
PROCESS_WINDOW_END=06:00
PROCESS_TIMEZONE=Asia/Kolkata
